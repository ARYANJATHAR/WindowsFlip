<Window x:Class="FlipNoteChrome.UI.Flip.FlipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Title="FlipNoteChrome">
    <Window.Resources>
        <Style x:Key="EditorButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#44403C"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Border x:Name="RootBorder" CornerRadius="12" Background="#FAFAF9" BorderBrush="#E7E5E4" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="38"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#1C1917" CornerRadius="12,12,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid Margin="18,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText" Text="Chrome Notes" Foreground="#FAFAF9" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SubtitleText" Text="Write freely — Alt+Click to return" Foreground="#A8A29E" FontSize="10.5" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="SaveIndicator" Text="● Saved" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#86EFAC" FontSize="11" Opacity="0.9"/>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Background="#F5F5F4" BorderBrush="#E7E5E4" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                        <Button Content="H1⌄" Click="Heading_Click" Style="{StaticResource EditorButton}"/>
                        <Button Content="☷⌄" Click="List_Click" Style="{StaticResource EditorButton}"/>
                        <Separator Margin="6,7"/>
                        <Button Content="B" FontWeight="Bold" Click="Bold_Click" Style="{StaticResource EditorButton}"/>
                        <Button Content="I" FontStyle="Italic" Click="Italic_Click" Style="{StaticResource EditorButton}"/>
                        <Button Content="S̶" Click="Strike_Click" Style="{StaticResource EditorButton}"/>
                        <Button Content="↗" Click="Link_Click" Style="{StaticResource EditorButton}"/>
                        <Button Content="▦" Click="Table_Click" Style="{StaticResource EditorButton}"/>
                        <Separator Margin="6,7"/>
                        <Button Content="A̶" Click="ClearFormatting_Click" Style="{StaticResource EditorButton}"/>
                    </StackPanel>
                </Border>
                <TextBox x:Name="EditorBox" Grid.Row="2" TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" FontFamily="Segoe UI" FontSize="16" Padding="28,24" BorderThickness="0" Background="White" Foreground="#1C1917" TextChanged="EditorBox_TextChanged"/>
                <Border Grid.Row="3" Background="#FAFAF9" BorderBrush="#E7E5E4" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12">
                    <Grid Margin="18,0">
                        <TextBlock x:Name="WordCountText" Text="0 words • 0 chars" Foreground="#78716C" FontSize="11" VerticalAlignment="Center"/>
                        <Button Content="Flip Back ↩" Padding="14,4" HorizontalAlignment="Right" FontSize="11" Background="#1C1917" Foreground="White" BorderBrush="#1C1917" Click="FlipBack_Click" Cursor="Hand"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <Viewport3D x:Name="FlipViewport" Visibility="Collapsed" ClipToBounds="True">
            <Viewport3D.Camera><PerspectiveCamera Position="0,0,4.2" LookDirection="0,0,-1" UpDirection="0,1,0" FieldOfView="42"/></Viewport3D.Camera>
            <ModelVisual3D><ModelVisual3D.Content><Model3DGroup>
                <AmbientLight Color="#FFFFFF"/><DirectionalLight Color="#FFFFFF" Direction="-0.5,-0.5,-1"/>
                <GeometryModel3D>
                    <GeometryModel3D.Geometry><MeshGeometry3D Positions="-1.5,-1,0 1.5,-1,0 1.5,1,0 -1.5,1,0" TriangleIndices="0 1 2 0 2 3" TextureCoordinates="0,1 1,1 1,0 0,0"/></GeometryModel3D.Geometry>
                    <GeometryModel3D.Material><DiffuseMaterial><DiffuseMaterial.Brush><ImageBrush x:Name="FrontBrush" Stretch="UniformToFill"/></DiffuseMaterial.Brush></DiffuseMaterial></GeometryModel3D.Material>
                    <GeometryModel3D.BackMaterial><DiffuseMaterial><DiffuseMaterial.Brush><VisualBrush x:Name="BackBrush" Stretch="Uniform"/></DiffuseMaterial.Brush></DiffuseMaterial></GeometryModel3D.BackMaterial>
                    <GeometryModel3D.Transform><RotateTransform3D><RotateTransform3D.Rotation><AxisAngleRotation3D x:Name="FlipRotation" Axis="0,1,0" Angle="0"/></RotateTransform3D.Rotation></RotateTransform3D></GeometryModel3D.Transform>
                </GeometryModel3D>
            </Model3DGroup></ModelVisual3D.Content></ModelVisual3D>
        </Viewport3D>
    </Grid>
</Window>
