<Window x:Class="FlipNoteChrome.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlipNoteChrome — Settings" Height="620" Width="700" WindowStartupLocation="CenterScreen"
        Background="#FAFAF9" ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="FlipNoteChrome" FontSize="22" FontWeight="Bold" Foreground="#1C1917"/>
            <TextBlock Text="Alt + Left-click Chrome title bar to flip • Ctrl+Alt+F for focused window" Foreground="#57534E" FontSize="12.5" Margin="0,6,0,0"/>
            <TextBlock x:Name="StatusText" Text="Hook active • Watching chrome.exe only • True 3D flip enabled" Foreground="#16A34A" FontSize="11" Margin="0,10,0,0" FontWeight="SemiBold"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,18,0,0" Background="White" CornerRadius="12" BorderBrush="#E7E5E4" BorderThickness="1" Padding="16">
            <StackPanel>
                <TextBlock Text="How to use" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10"/>
                <TextBlock TextWrapping="Wrap" Foreground="#44403C" LineHeight="20">
                    1. Open Chrome. Hold Alt and click the title bar (top bar with tabs/close buttons).<LineBreak/>
                    2. Chrome flips with a true 3D perspective (≈350ms) and shows your scratchpad — same size as Chrome.<LineBreak/>
                    3. Write your note. It auto-saves and keeps version history.<LineBreak/>
                    4. Press Esc, Flip Back, or Alt+Click again to return. Notes survive restarts per window identity.
                </TextBlock>
                <Separator Margin="0,14" Background="#F5F5F4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Storage" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock x:Name="DbPathText" Text="%APPDATA%\FlipNoteChrome\notes.db" Foreground="#78716C" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="NoteCountText" Text="0 notes" Foreground="#57534E" FontSize="11" Margin="0,4,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Search Notes…" Padding="10,6" Click="Search_Click" Background="White" BorderBrush="#E7E5E4" Cursor="Hand" FontSize="11"/>
                            <Button Content="Export All → Folder" Padding="10,6" Margin="6,0,0,0" Click="ExportAll_Click" Background="White" BorderBrush="#E7E5E4" Cursor="Hand" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="Current Chrome windows" FontWeight="SemiBold" FontSize="12"/>
                        <ListBox x:Name="ChromeList" Height="104" Margin="0,6,0,0" BorderBrush="#E7E5E4" FontSize="11"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Refresh" Padding="10,4" Click="Refresh_Click" Background="#1C1917" Foreground="White" BorderBrush="#1C1917" Cursor="Hand" FontSize="11"/>
                            <Button Content="Open Folder" Padding="10,4" Margin="6,0,0,0" Click="OpenFolder_Click" Background="White" BorderBrush="#E7E5E4" Cursor="Hand" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Settings -->
        <Border Grid.Row="2" Margin="0,16,0,0" Background="White" CornerRadius="12" BorderBrush="#E7E5E4" BorderThickness="1" Padding="16">
            <StackPanel>
                <TextBlock Text="Settings" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,12"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Animation speed (ms)" FontSize="11" Foreground="#57534E"/>
                        <Slider x:Name="AnimSlider" Minimum="200" Maximum="600" Value="350" TickFrequency="50" IsSnapToTickEnabled="True" Width="260" HorizontalAlignment="Left" ValueChanged="AnimSlider_ValueChanged"/>
                        <TextBlock x:Name="AnimLabel" Text="350 ms" FontSize="11" Foreground="#1C1917" Margin="0,4,0,0"/>
                        <CheckBox x:Name="True3DCheck" Content="Use True 3D flip (Viewport3D) — fallback to Scale if capture fails" Margin="0,12,0,0" Checked="SettingChanged" Unchecked="SettingChanged"/>
                        <CheckBox x:Name="AlwaysOnTopCheck" Content="Always on top when flipped" Margin="0,8,0,0" Checked="SettingChanged" Unchecked="SettingChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <TextBlock Text="Font" FontSize="11" Foreground="#57534E"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <ComboBox x:Name="FontBox" Width="140" SelectionChanged="SettingChanged">
                                <ComboBoxItem Content="Segoe UI"/>
                                <ComboBoxItem Content="Cascadia Code"/>
                                <ComboBoxItem Content="Consolas"/>
                                <ComboBoxItem Content="Arial"/>
                            </ComboBox>
                            <TextBlock Text="Size" VerticalAlignment="Center" Margin="10,0,6,0" FontSize="11"/>
                            <ComboBox x:Name="FontSizeBox" Width="70" SelectionChanged="SettingChanged">
                                <ComboBoxItem Content="12"/>
                                <ComboBoxItem Content="14"/>
                                <ComboBoxItem Content="16"/>
                                <ComboBoxItem Content="18"/>
                            </ComboBox>
                        </StackPanel>
                        <CheckBox x:Name="AutoStartCheck" Content="Auto-start with Windows" Margin="0,14,0,0" Checked="SettingChanged" Unchecked="SettingChanged"/>
                        <TextBlock Text="Exclude list (comma-separated exe names)" FontSize="11" Foreground="#57534E" Margin="0,10,0,0"/>
                        <TextBox x:Name="ExcludeBox" Height="26" Margin="0,4,0,0" Padding="6,4" LostFocus="SettingChanged"/>
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <TextBlock Text="Tray app — close window keeps hooks alive" Foreground="#A8A29E" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="Save &amp; Hide to Tray" Padding="16,6" Click="Hide_Click" Background="#1C1917" Foreground="White" BorderBrush="#1C1917" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
    </ScrollViewer>
</Window>
