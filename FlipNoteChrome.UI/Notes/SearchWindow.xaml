<Window x:Class="FlipNoteChrome.UI.Notes.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Search &amp; History — FlipNoteChrome" Height="560" Width="820" WindowStartupLocation="CenterScreen"
        Background="#FAFAF9">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Search all Chrome notes" FontSize="18" FontWeight="SemiBold" Foreground="#1C1917"/>
        <Grid Grid.Row="1" Margin="0,14,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Padding="12,8" FontSize="13" BorderBrush="#E7E5E4" BorderThickness="1" TextChanged="SearchBox_TextChanged"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                <Button Content="Export All" Padding="12,6" Click="ExportAll_Click" Background="White" BorderBrush="#E7E5E4" Cursor="Hand"/>
                <Button Content="History" Padding="12,6" Margin="6,0,0,0" Click="History_Click" Background="#1C1917" Foreground="White" BorderBrush="#1C1917" Cursor="Hand"/>
            </StackPanel>
        </Grid>
        <ListBox x:Name="ResultsList" Grid.Row="2" BorderBrush="#E7E5E4" BorderThickness="1" Background="White" SelectionChanged="ResultsList_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10" BorderBrush="#F5F5F4" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="{Binding NormalizedTitle}" FontWeight="SemiBold" Foreground="#1C1917" FontSize="13"/>
                            <TextBlock Text="{Binding Markdown}" TextTrimming="CharacterEllipsis" MaxHeight="48" Foreground="#57534E" FontSize="12" Margin="0,4,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding UpdatedUtc}" Foreground="#A8A29E" FontSize="10"/>
                                <TextBlock Text="  •  " Foreground="#A8A29E" FontSize="10"/>
                                <TextBlock Text="{Binding StableKey}" Foreground="#D6D3D1" FontSize="10" FontFamily="Consolas"/>
                                <TextBlock Text="{Binding Pinned,StringFormat='  •  Pinned: {0}'}" Foreground="#16A34A" FontSize="10" Margin="0,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Border Grid.Row="3" Margin="0,10,0,0" Background="White" BorderBrush="#E7E5E4" BorderThickness="1" CornerRadius="8" Padding="12" Visibility="Collapsed" x:Name="HistoryPanel">
            <StackPanel>
                <TextBlock Text="Version history (last 20)" FontWeight="SemiBold" FontSize="12" Foreground="#1C1917"/>
                <ListBox x:Name="HistoryList" MaxHeight="140" Margin="0,8,0,0" BorderBrush="#F5F5F4" FontSize="11"/>
                <TextBlock Text="Click a version to preview — history is kept automatically on each save (last 50 per window)." Foreground="#A8A29E" FontSize="10.5" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
